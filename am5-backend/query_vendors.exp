#!/usr/bin/expect -f
set timeout -1
spawn ssh -o StrictHostKeyChecking=no root@76.13.245.174
expect "password:"
send "Am5royal@2026\r"
expect "# "

send "docker exec -i am5_backend python - << 'PYEOF'\r"
send "import asyncio\r"
send "from app.db.session import AsyncSessionLocal\r"
send "from sqlalchemy import text\r"
send "async def run():\r"
send "    async with AsyncSessionLocal() as db:\r"
send "        res = await db.execute(text(\"SELECT id, user_id, first_name, email, alternative_number FROM vendors WHERE email = 'vendor_7013985800@am5royal.com'\"))\r"
send "        print('Vendor by email:', res.fetchall())\r"
send "        res2 = await db.execute(text(\"SELECT id, email, mobile FROM users WHERE email = 'vendor_7013985800@am5royal.com' OR mobile = '7013985800'\"))\r"
send "        print('Users by email/mobile:', res2.fetchall())\r"
send "asyncio.run(run())\r"
send "PYEOF\r"

expect "# "
send "exit\r"
