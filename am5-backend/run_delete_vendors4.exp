send "docker exec -i am5_backend python - << 'PYEOF'\r"
send "import asyncio\r"
send "from app.db.session import AsyncSessionLocal\r"
send "from sqlalchemy import text\r"
send "async def run():\r"
send "    async with AsyncSessionLocal() as db:\r"
send "        res = await db.execute(text(\"\"\"\r"
send "SELECT\r"
send "    tc.table_name, kcu.column_name\r"
send "FROM\r"
send "    information_schema.table_constraints AS tc\r"
send "    JOIN information_schema.key_column_usage AS kcu\r"
send "      ON tc.constraint_name = kcu.constraint_name\r"
send "      AND tc.table_schema = kcu.table_schema\r"
send "    JOIN information_schema.constraint_column_usage AS ccu\r"
send "      ON ccu.constraint_name = tc.constraint_name\r"
send "      AND ccu.table_schema = tc.table_schema\r"
send "WHERE tc.constraint_type = 'FOREIGN KEY'\r"
send "  AND ccu.table_name = 'vendors';\r"
send "\"\"\"))\r"
send "        print('Tables referencing vendors:', res.fetchall())\r"
send "        \r"
send "        res2 = await db.execute(text(\"\"\"\r"
send "SELECT\r"
send "    tc.table_name, kcu.column_name\r"
send "FROM\r"
send "    information_schema.table_constraints AS tc\r"
send "    JOIN information_schema.key_column_usage AS kcu\r"
send "      ON tc.constraint_name = kcu.constraint_name\r"
send "      AND tc.table_schema = kcu.table_schema\r"
send "    JOIN information_schema.constraint_column_usage AS ccu\r"
send "      ON ccu.constraint_name = tc.constraint_name\r"
send "      AND ccu.table_schema = tc.table_schema\r"
send "WHERE tc.constraint_type = 'FOREIGN KEY'\r"
send "  AND ccu.table_name = 'users';\r"
send "\"\"\"))\r"
send "        print('Tables referencing users:', res2.fetchall())\r"
send "asyncio.run(run())\r"
send "PYEOF\r"

